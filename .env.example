GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_OTLP_TOKEN=
# Required only for Live run. This is the Grafana Cloud Prometheus/Mimir API URL,
# e.g. https://prometheus-prod-XX-prod-YY.grafana.net/api/prom
GRAFANA_PROMETHEUS_URL=
# Optional if your Mimir credentials differ from the OTLP instance/token above.
GRAFANA_PROMETHEUS_INSTANCE_ID=
GRAFANA_PROMETHEUS_TOKEN=
GCP_PROJECT_ID=cutscope
GCP_REGION=us-central1
# Optional runtime controls. Defaults use Vertex Veo 3.1 Fast at 720p, video-only.
VEO_MODEL=veo-3.1-fast-generate-001
GEMINI_MODEL=gemini-2.5-flash
VEO_RESOLUTION=720p
VEO_GENERATE_AUDIO=false
VEO_POLL_INTERVAL_SECONDS=15
VEO_POLL_TIMEOUT_SECONDS=900
